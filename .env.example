# Copy to .env and replace every secret before this host is reachable
# beyond localhost. Development defaults below only exist so local
# Mosquitto comes up; they are not safe on a LAN.

# UniFi (console: Settings → Control Plane → Integrations)
UNIFI_URL=https://192.168.1.1
UNIFI_SITE=default
UNIFI_READ_KEY=
UNIFI_WRITE_KEY=

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER_API=api
MQTT_PASS_API=dev-api-pass
MQTT_USER_GATEWAY=gateway
MQTT_PASS_GATEWAY=dev-gateway-pass
MQTT_USER_ESP32=esp32
MQTT_PASS_ESP32=dev-esp32-pass

# Netwatch
NETWATCH_DB=./netwatch.db
NETWATCH_API_BIND=0.0.0.0:8765
NETWATCH_API=http://127.0.0.1:8765
NETWATCH_API_TOKEN=dev-api-token
NETWATCH_HMAC_SECRET=dev-hmac-secret
PROPOSAL_TTL_SEC=120
ARRIVAL_ABSENCE_MIN=20

# NVIDIA Build — the agent's model. Create a key at build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# T-Display-S3 AMOLED plugged into this machine (USB JTAG/serial).
DISPLAY_PORT=/dev/cu.usbmodem3101
AGENT_QUIET_SEC=900
